# Generated at build time (Netlify rebuilds it and stamps the Mapbox token in)
index.html

# Local configuration and secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*-key.json
*sa-key*.json
secrets/
.assetlogic/

# Internal documentation (ERD, infrastructure map, full schema, database setup): never public
docs/internal/

# Local data drops (parcel GeoJSON, exports) are imported into the database, not committed
data/
parcels/
*.geojson
*.gpkg
*.shp
*.dbf
*.shx
*.prj
*.zip

# Tooling
.netlify/
.claude/
node_modules/
.DS_Store
Thumbs.db
