    "db:migrate": "node --use-system-ca scripts/db-migrate.js",
    "db:load-assets": "node --use-system-ca scripts/load-assets.js",
    "db:import-parcels": "node --use-system-ca scripts/import-parcels.js"
  },
  "repository": {
    "type": "git",
