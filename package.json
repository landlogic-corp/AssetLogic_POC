  "description": "Clickable proof of concept for an asset monitoring module inside the LandLogic platform. All property, planning and market data in it is example data.",
  "scripts": {
    "build": "node scripts/build-index.js",
    "dev": "node --use-system-ca scripts/dev-server.js",
