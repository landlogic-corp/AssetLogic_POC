# Copy this file to .env.local (git-ignored) and fill in the values.
# Every value below is issued by the project administrator. Do not commit them, paste them in chat,
# or put them anywhere inside the repository other than .env.local.

# Mapbox: public token (starts with pk.) and the basemap style URL
MAPBOX_TOKEN=
MAPBOX_STYLE=

# Database (Google Cloud SQL, PostgreSQL + PostGIS)
DB_INSTANCE=          # connection name in the form project:region:instance
DB_NAME=
DB_USER=
DB_PASSWORD=

# Absolute path to the service-account key file. Keep the file OUTSIDE the repository,
# for example in a .assetlogic folder in your home directory.
GCP_SA_KEY_FILE=
