# Copy to .env.local (git-ignored) and fill in. Netlify holds the same names as environment variables.

# Mapbox (public token, URL-restricted to localhost and the Netlify site)
MAPBOX_TOKEN=
MAPBOX_STYLE=

# Google Cloud SQL (PostgreSQL + PostGIS). The service account key is a file path locally and the
# JSON contents on Netlify. Never commit either.
DB_INSTANCE=          # project:region:instance, from the Cloud SQL instance page
DB_NAME=assetlogic
DB_USER=assetlogic_app
DB_PASSWORD=
GCP_SA_KEY_FILE=C:\Users\Soroosh Sanjarani\.assetlogic\gcp-sa-key.json
